{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LivroDeReceitas.API (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Backend/LivroDeReceitas.API/bin/Debug/net10.0/LivroDeReceitas.API.dll",
      "cwd": "${workspaceFolder}/src/Backend/LivroDeReceitas.API",
      "launchSettingsFilePath": "${workspaceFolder}/src/Backend/LivroDeReceitas.API/Properties/launchSettings.json",
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/scalar/v1"
      }
    }
  ]
}
